{
  "name": "eshop-web",
  "private": true,
  "version": "1.0.0",
  "description": "Eshop storefront and admin dashboard",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev --workspace=@eshop/storefront",
    "dev:admin": "npm run dev --workspace=@eshop/admin",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "vitest run",
    "clean": "rm -rf apps/*/.next apps/*/node_modules packages/*/node_modules node_modules",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^22.10.2",
    "jsdom": "^30.0.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.9"
  }
}
