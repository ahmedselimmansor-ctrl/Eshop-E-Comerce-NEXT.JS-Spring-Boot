/**
 * Stateful services: Cloud SQL, Memorystore, and Cloud Storage.
 *
 * These are the resources where a mistake is expensive and often irreversible, so the defaults here
 * lean conservative: deletion protection on, backups on, point-in-time recovery on, and public IP
 * off everywhere.
 */

# ---------------------------------------------------------------- PostgreSQL --

resource "google_sql_database_instance" "main" {
  name             = "${var.name_prefix}-postgres"
  database_version = "POSTGRES_16"
  region           = var.region

  # The instance cannot be created before the VPC peering exists.
  depends_on = [var.private_vpc_connection]

  # A `terraform destroy` that silently takes the production database with it is not a risk worth
  # accepting for the convenience of not having to flip a flag.
  deletion_protection = var.environment == "prod"

  settings {
    tier              = var.db_tier
    availability_type = var.environment == "prod" ? "REGIONAL" : "ZONAL"
    disk_type         = "PD_SSD"
    disk_size         = var.db_disk_size_gb

    # Grows the disk before it fills. A full disk takes PostgreSQL read-only, which reads as a total
    # outage, and the fix requires a restart.
    disk_autoresize       = true
    disk_autoresize_limit = var.db_disk_limit_gb

    ip_configuration {
      # No public address at all. The database is reachable only from the VPC.
      ipv4_enabled                                  = false
      private_network                               = var.network_id
      enable_private_path_for_google_cloud_services = true
      ssl_mode                                      = "ENCRYPTED_ONLY"
    }

    backup_configuration {
      enabled = true
      # 02:00 Cairo is 00:00 UTC - the quietest hour for an Egyptian storefront.
      start_time                     = "00:00"
      location                       = var.region
      point_in_time_recovery_enabled = true
      # Seven days of WAL: long enough to recover from a mistake noticed the following week, which
      # is the realistic detection window for a bad data migration.
      transaction_log_retention_days = 7

      backup_retention_settings {
        retained_backups = var.environment == "prod" ? 30 : 7
        retention_unit   = "COUNT"
      }
    }

    maintenance_window {
      day  = 2 # Tuesday
      hour = 1
      # Stable rather than canary: production should receive a patch after it has been running
      # elsewhere, not first.
      update_track = var.environment == "prod" ? "stable" : "canary"
    }

    insights_config {
      query_insights_enabled  = true
      query_string_length     = 1024
      record_application_tags = true
      record_client_address   = false # client addresses are PII-adjacent and not needed here
    }

    database_flags {
      name  = "max_connections"
      value = var.db_max_connections
    }

    database_flags {
      # Logs anything slower than a second. The pool is sized well below max_connections, so a slow
      # query is the usual cause of pool exhaustion and this is how it gets found.
      name  = "log_min_duration_statement"
      value = "1000"
    }

    database_flags {
      name  = "log_checkpoints"
      value = "on"
    }

    user_labels = {
      environment = var.environment
      component   = "database"
    }
  }
}

resource "google_sql_database" "eshop" {
  name     = "eshop"
  instance = google_sql_database_instance.main.name

  # Matches the collation used locally in docker-compose, so index ordering and LIKE behaviour are
  # identical in both places.
  charset   = "UTF8"
  collation = "en_US.UTF8"
}

/**
 * Read replica.
 *
 * Production only. Admin reporting and dashboard aggregates are read-heavy and bursty; routing
 * them here keeps a merchandiser running a year-long revenue query from competing with checkout
 * for the primary's buffer cache.
 */
resource "google_sql_database_instance" "replica" {
  count = var.environment == "prod" ? 1 : 0

  name                 = "${var.name_prefix}-postgres-replica"
  database_version     = "POSTGRES_16"
  region               = var.region
  master_instance_name = google_sql_database_instance.main.name
  deletion_protection  = false

  replica_configuration {
    failover_target = false
  }

  settings {
    tier              = var.db_replica_tier
    availability_type = "ZONAL"
    disk_type         = "PD_SSD"

    ip_configuration {
      ipv4_enabled    = false
      private_network = var.network_id
      ssl_mode        = "ENCRYPTED_ONLY"
    }

    user_labels = {
      environment = var.environment
      component   = "database-replica"
    }
  }
}

/**
 * Database password.
 *
 * Generated by Terraform and written straight to Secret Manager - it is never printed, never in a
 * tfvars file, and never in a CI variable. The only way to read it is a Secret Manager access,
 * which is logged.
 */
resource "random_password" "db" {
  length  = 32
  special = true
  # Excludes characters that need escaping in a JDBC URL or a shell.
  override_special = "!#$%&*()-_=+[]{}<>:?"
}

resource "google_sql_user" "app" {
  name     = "eshop"
  instance = google_sql_database_instance.main.name
  password = random_password.db.result
}

resource "google_secret_manager_secret" "db_password" {
  secret_id = "eshop-db-password"

  replication {
    user_managed {
      replicas {
        location = var.region
      }
    }
  }

  labels = {
    environment = var.environment
  }
}

resource "google_secret_manager_secret_version" "db_password" {
  secret      = google_secret_manager_secret.db_password.id
  secret_data = random_password.db.result
}

# ------------------------------------------------------------------- Redis --

resource "google_redis_instance" "cache" {
  name           = "${var.name_prefix}-redis"
  tier           = var.environment == "prod" ? "STANDARD_HA" : "BASIC"
  memory_size_gb = var.redis_memory_gb
  region         = var.region

  authorized_network = var.network_id
  connect_mode       = "PRIVATE_SERVICE_ACCESS"
  depends_on         = [var.private_vpc_connection]

  redis_version = "REDIS_7_2"

  # Both on in production. The cache holds carts and rate-limit buckets - not durable data, but
  # losing it mid-session logs everyone out of their cart at once.
  auth_enabled            = true
  transit_encryption_mode = var.environment == "prod" ? "SERVER_AUTHENTICATION" : "DISABLED"

  redis_configs = {
    # Evicts the least recently used key when full rather than returning errors. Everything stored
    # here is reconstructible from PostgreSQL, so eviction is the correct failure mode.
    maxmemory-policy = "allkeys-lru"
  }

  maintenance_policy {
    weekly_maintenance_window {
      day = "TUESDAY"
      start_time {
        hours   = 2
        minutes = 0
      }
    }
  }

  labels = {
    environment = var.environment
    component   = "cache"
  }
}

resource "google_secret_manager_secret" "redis_auth" {
  secret_id = "eshop-redis-auth"

  replication {
    user_managed {
      replicas {
        location = var.region
      }
    }
  }
}

resource "google_secret_manager_secret_version" "redis_auth" {
  secret      = google_secret_manager_secret.redis_auth.id
  secret_data = google_redis_instance.cache.auth_string
}

# --------------------------------------------------------------- Storage --

/**
 * Public media bucket, fronted by Cloud CDN.
 *
 * Uniform bucket-level access rather than per-object ACLs: object ACLs are how a bucket ends up
 * accidentally world-writable, and they cannot be audited in aggregate.
 */
resource "google_storage_bucket" "media" {
  name          = "${var.name_prefix}-media"
  location      = var.region
  storage_class = "STANDARD"

  uniform_bucket_level_access = true
  public_access_prevention    = "inherited" # served publicly through the CDN

  versioning {
    enabled = true
  }

  # CORS is scoped to our own origins. A wildcard here would let any site hotlink the media bucket
  # and bill us for the egress.
  cors {
    origin          = var.cors_origins
    method          = ["GET", "HEAD"]
    response_header = ["Content-Type", "Cache-Control"]
    max_age_seconds = 3600
  }

  lifecycle_rule {
    condition {
      age                = 30
      with_state         = "ARCHIVED" # non-current versions only
      num_newer_versions = 3
    }
    action {
      type = "Delete"
    }
  }

  labels = {
    environment = var.environment
    component   = "media"
  }
}

resource "google_storage_bucket_iam_member" "media_public_read" {
  bucket = google_storage_bucket.media.name
  role   = "roles/storage.objectViewer"
  member = "allUsers"
}

/**
 * Private bucket: invoices, data exports, anything reached only through a signed URL.
 *
 * `public_access_prevention = enforced` makes it impossible to grant public access to this bucket
 * even by mistake - the API returns an error rather than applying the binding.
 */
resource "google_storage_bucket" "private" {
  name          = "${var.name_prefix}-private"
  location      = var.region
  storage_class = "STANDARD"

  uniform_bucket_level_access = true
  public_access_prevention    = "enforced"

  versioning {
    enabled = true
  }

  lifecycle_rule {
    condition {
      # Invoices are retained for seven years for tax purposes; exports are transient. The split is
      # by prefix, applied by the export job's own object naming.
      age            = 2555
      matches_prefix = ["exports/"]
    }
    action {
      type = "Delete"
    }
  }

  labels = {
    environment = var.environment
    component   = "private-storage"
  }
}
