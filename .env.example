# Copy to .env and fill in. `.env` is gitignored and must never be committed.
#
# In deployed environments none of these come from a file: they are stored in Secret Manager and
# projected into pods by the External Secrets Operator (see infra/k8s). This file exists for local
# development and as the canonical list of what the application reads.

# ==============================================================================
# Core
# ==============================================================================
SPRING_PROFILES_ACTIVE=local
APP_BASE_URL=http://localhost:8080
WEB_BASE_URL=http://localhost:3000
ADMIN_BASE_URL=http://localhost:3001
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ==============================================================================
# Database
# ==============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=eshop
DB_USER=eshop
DB_PASSWORD=eshop
DB_POOL_MAX=20

# ==============================================================================
# Redis
# ==============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false

# ==============================================================================
# Elasticsearch
# ==============================================================================
ELASTICSEARCH_URIS=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_ENABLED=true

# ==============================================================================
# JWT signing keys
# ==============================================================================
# RS256 keypair, PEM. Leave blank locally and an ephemeral pair is generated at startup — which
# also means every restart invalidates outstanding tokens, the correct behaviour for a throwaway key.
#
# Generate a real pair with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
#   openssl rsa -in private.pem -pubout -out public.pem
#
# Store both in Secret Manager. Never commit either.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=https://api.eshop.eg
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
REFRESH_COOKIE_SECURE=false

# ==============================================================================
# Google sign-in (optional)
# ==============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ==============================================================================
# Payments — Paymob
# ==============================================================================
# From the Paymob dashboard. HMAC_SECRET verifies callbacks: with it blank, every webhook is
# rejected, which is the safe default but means payments never settle.
PAYMOB_ENABLED=true
PAYMOB_BASE_URL=https://accept.paymob.com/api
PAYMOB_API_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_SECRET_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_IFRAME_ID=
PAYMOB_INTEGRATION_ID_CARD=
PAYMOB_INTEGRATION_ID_WALLET=
PAYMOB_INTEGRATION_ID_INSTALLMENT=

# ==============================================================================
# Payments — Fawry
# ==============================================================================
# Staging base URL by default. Production is https://www.atfawry.com
FAWRY_ENABLED=true
FAWRY_BASE_URL=https://atfawry.fawrystaging.com
FAWRY_MERCHANT_CODE=
FAWRY_SECURITY_KEY=

# ==============================================================================
# Storage
# ==============================================================================
# `local` writes to a temp directory; `gcs` uses Cloud Storage via Workload Identity.
STORAGE_PROVIDER=local
GCP_PROJECT_ID=eshop-local
GCS_MEDIA_BUCKET=eshop-media-local
GCS_PRIVATE_BUCKET=eshop-private-local
GCS_CDN_BASE_URL=http://localhost:4443/eshop-media-local

# ==============================================================================
# Mail
# ==============================================================================
# Mailpit catches everything locally — read it at http://localhost:8025
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@eshop.eg

# ==============================================================================
# Push notifications
# ==============================================================================
FCM_ENABLED=false
FCM_CREDENTIALS_JSON=

# ==============================================================================
# Observability
# ==============================================================================
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_SERVICE_NAME=eshop-backend
TRACE_SAMPLE_RATE=1.0
LOG_LEVEL_APP=DEBUG

# ==============================================================================
# Frontend
# ==============================================================================
# NEXT_PUBLIC_* values are inlined into the client bundle at build time — they are public by
# definition and must never hold a secret.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CDN_BASE_URL=http://localhost:4443/eshop-media-local
NEXT_PUBLIC_DEFAULT_LOCALE=ar

# Server-side only: the cluster-internal API address, used by server components so a render does
# not round-trip through the external load balancer.
API_INTERNAL_BASE_URL=http://localhost:8080
