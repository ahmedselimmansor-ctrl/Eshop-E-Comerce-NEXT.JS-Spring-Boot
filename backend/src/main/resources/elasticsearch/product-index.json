{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 1,
    "refresh_interval": "5s",
    "max_result_window": 20000,
    "analysis": {
      "filter": {
        "arabic_stop": { "type": "stop", "stopwords": "_arabic_" },
        "arabic_stemmer": { "type": "stemmer", "language": "arabic" },
        "english_stop": { "type": "stop", "stopwords": "_english_" },
        "english_stemmer": { "type": "stemmer", "language": "english" },
        "edge_ngram_filter": { "type": "edge_ngram", "min_gram": 2, "max_gram": 20 }
      },
      "char_filter": {
        "_comment_arabic_normalisation": "Unifies the letter forms shoppers type interchangeably, so بحث for 'موبايل' matches 'مُوبايل' and 'احمد' matches 'أحمد'.",
        "arabic_letters": {
          "type": "mapping",
          "mappings": [
            "أ=>ا", "إ=>ا", "آ=>ا", "ٱ=>ا",
            "ى=>ي", "ئ=>ي",
            "ة=>ه",
            "ؤ=>و",
            "ـ=>"
          ]
        }
      },
      "analyzer": {
        "arabic_text": {
          "type": "custom",
          "char_filter": ["arabic_letters"],
          "tokenizer": "standard",
          "filter": ["lowercase", "decimal_digit", "arabic_normalization", "arabic_stop", "arabic_stemmer"]
        },
        "english_text": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": ["lowercase", "asciifolding", "english_stop", "english_stemmer"]
        },
        "autocomplete_index": {
          "type": "custom",
          "char_filter": ["arabic_letters"],
          "tokenizer": "standard",
          "filter": ["lowercase", "asciifolding", "arabic_normalization", "edge_ngram_filter"]
        },
        "autocomplete_search": {
          "type": "custom",
          "char_filter": ["arabic_letters"],
          "tokenizer": "standard",
          "filter": ["lowercase", "asciifolding", "arabic_normalization"]
        }
      }
    }
  },

  "mappings": {
    "dynamic": "strict",
    "_comment": "strict so a field added to the entity without a mapping fails loudly at index time rather than silently becoming unsearchable.",
    "properties": {
      "id":   { "type": "keyword" },
      "sku":  { "type": "keyword" },
      "slug": { "type": "keyword" },

      "nameAr": {
        "type": "text",
        "analyzer": "arabic_text",
        "fields": {
          "keyword": { "type": "keyword", "ignore_above": 256 },
          "autocomplete": {
            "type": "text",
            "analyzer": "autocomplete_index",
            "search_analyzer": "autocomplete_search"
          }
        }
      },
      "nameEn": {
        "type": "text",
        "analyzer": "english_text",
        "fields": {
          "keyword": { "type": "keyword", "ignore_above": 256 },
          "autocomplete": {
            "type": "text",
            "analyzer": "autocomplete_index",
            "search_analyzer": "autocomplete_search"
          }
        }
      },

      "descriptionAr": { "type": "text", "analyzer": "arabic_text" },
      "descriptionEn": { "type": "text", "analyzer": "english_text" },

      "brandId":   { "type": "keyword" },
      "brandSlug": { "type": "keyword" },
      "brandNameAr": { "type": "text", "analyzer": "arabic_text", "fields": { "keyword": { "type": "keyword" } } },
      "brandNameEn": { "type": "text", "analyzer": "english_text", "fields": { "keyword": { "type": "keyword" } } },

      "categoryIds":   { "type": "keyword" },
      "categorySlugs": { "type": "keyword" },
      "categoryNameAr": { "type": "keyword" },
      "categoryNameEn": { "type": "keyword" },

      "price":          { "type": "scaled_float", "scaling_factor": 100 },
      "compareAtPrice": { "type": "scaled_float", "scaling_factor": 100 },
      "currency":       { "type": "keyword" },
      "onSale":         { "type": "boolean" },
      "discountPercent": { "type": "integer" },

      "ratingAvg":   { "type": "half_float" },
      "ratingCount": { "type": "integer" },
      "soldCount":   { "type": "integer" },
      "viewCount":   { "type": "long" },

      "inStock":           { "type": "boolean" },
      "availableQuantity": { "type": "integer" },

      "imageUrl":  { "type": "keyword", "index": false },
      "blurhash":  { "type": "keyword", "index": false },
      "status":    { "type": "keyword" },
      "featured":  { "type": "boolean" },
      "publishedAt": { "type": "date" },
      "updatedAt":   { "type": "date" },

      "_comment_attributes": "Nested rather than object: a flat object would let a query match 'colour red' on one product and 'size large' on another and report it as one match.",
      "attributes": {
        "type": "nested",
        "properties": {
          "code":      { "type": "keyword" },
          "valueCode": { "type": "keyword" },
          "valueAr":   { "type": "keyword" },
          "valueEn":   { "type": "keyword" }
        }
      },

      "searchKeywords": {
        "type": "text",
        "analyzer": "arabic_text",
        "fields": {
          "english": { "type": "text", "analyzer": "english_text" }
        }
      }
    }
  }
}
